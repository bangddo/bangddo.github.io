rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 권한 마커
    match /admins/{uid} {
      // 본인이 자기 권한 확인 (UI에서 "내가 admin 인지" 체크)
      allow get: if request.auth != null && request.auth.uid == uid;
      // 관리자만 전체 목록 조회
      allow list: if isAdmin();
      // 관리자만 신규 부여/회수
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // 초대 코드 (관리자가 발급, 가입자가 사용 표시)
    match /inviteCodes/{code} {
      // 누구나 코드 유효성 확인 (미인증 가입자가 진입 시)
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && request.resource.data.keys().hasOnly(
          ['createdBy', 'createdAt', 'expiresAt', 'usedBy', 'usedAt']);

      // 가입자가 본인 사용 표시 (usedBy/usedAt 만 변경)
      // 또는 관리자가 만료 처리 (expiresAt 만 변경)
      allow update: if request.auth != null && (
        (resource.data.usedBy == null
          && request.time < resource.data.expiresAt
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid)
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['expiresAt']))
      );

      allow delete: if isAdmin();
    }

    // 가입 요청 (admin claim 부여 대기)
    match /adminRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 본인이 자기 요청 작성 — invite 코드가 실재해야 함
      // (usedBy 검사는 batched write 안에서 평가가 같은 batch 의 update 를 못 보기 때문에 제거.
      //  invite 의 1회성 보장은 inviteCodes update 룰의 `usedBy == null` 조건이 담당)
      allow create: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        && request.resource.data.keys().hasOnly(['email', 'inviteCode', 'requestedAt']);

      // 거부(본인 또는 관리자가 삭제), 승인은 별도 (admins 생성 + 이 문서 삭제)
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      // 관리자가 거부 사유 기록 (status/rejectedReason/rejectedAt/rejectedBy 만 추가)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(
          ['status', 'rejectedReason', 'rejectedAt', 'rejectedBy'])
        && request.resource.data.status == 'rejected'
        && request.resource.data.rejectedBy == request.auth.uid;
    }

    match /votes/{voteId} {
      // 공개 투표는 누구나 read, 비공개는 관리자만 read
      allow read: if isAdmin() || resource.data.isPublic == true;
      allow create, update, delete: if isAdmin();

      match /ballots/{phoneHash} {
        // 관리자만 ballot 조회 (결과 집계)
        allow read: if isAdmin();

        // 일반 사용자는 자기 ballot 만들기 가능 — 단, 다음 조건 모두 충족할 때:
        // 1) 부모 투표가 공개 상태
        // 2) 같은 phoneHash 가 아직 없음 (1인 1표)
        // 3) phoneHash 가 vote.allowedPhoneHashes 에 포함됨
        // 4) 현재 시간이 startAt ~ endAt 사이
        // 5) choices 가 유효한 인덱스 배열, 길이 1 ~ maxChoices
        allow create: if
          get(/databases/$(database)/documents/votes/$(voteId)).data.isPublic == true
          && !exists(/databases/$(database)/documents/votes/$(voteId)/ballots/$(phoneHash))
          && phoneHash in get(/databases/$(database)/documents/votes/$(voteId)).data.allowedPhoneHashes
          && request.time >= get(/databases/$(database)/documents/votes/$(voteId)).data.startAt
          && request.time <= get(/databases/$(database)/documents/votes/$(voteId)).data.endAt
          && request.resource.data.keys().hasOnly(['choices', 'submittedAt'])
          && request.resource.data.choices is list
          && request.resource.data.choices.size() >= 1
          && request.resource.data.choices.size() <= get(/databases/$(database)/documents/votes/$(voteId)).data.maxChoices;

        // 한 번 작성한 표는 수정/삭제 불가 (관리자가 vote 삭제 시에만 함께 정리)
        allow update: if false;
        allow delete: if isAdmin();
      }

      // 등록자 이름 매핑 — 관리자 전용 (개인정보 보호)
      // phoneHash → name 매핑이 vote 문서 본체에 있으면 isPublic==true 시
      // 누구나 read 되어 노출되므로 별도 서브컬렉션으로 분리.
      match /phoneNames/{phoneHash} {
        allow read, write: if isAdmin();
      }

      // 참여 마커 — 익명성 보호를 위해 ballots 와 분리
      // 유권자가 "내가 이 투표에 참여했는지" 만 확인할 수 있도록 get 공개
      // (choices 는 ballots 에만 들어있고 ballots 는 관리자만 read)
      match /voters/{phoneHash} {
        allow get: if true;
        allow list: if isAdmin();

        allow create: if
          get(/databases/$(database)/documents/votes/$(voteId)).data.isPublic == true
          && !exists(/databases/$(database)/documents/votes/$(voteId)/voters/$(phoneHash))
          && phoneHash in get(/databases/$(database)/documents/votes/$(voteId)).data.allowedPhoneHashes
          && request.time >= get(/databases/$(database)/documents/votes/$(voteId)).data.startAt
          && request.time <= get(/databases/$(database)/documents/votes/$(voteId)).data.endAt
          && request.resource.data.keys().hasOnly(['at']);

        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
